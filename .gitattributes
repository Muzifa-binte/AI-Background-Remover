# Normalize line endings to LF in the repository,
# and check out with LF on all platforms (cross-platform consistency).
* text=auto eol=lf

# Explicitly declare text files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env   text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.whl   binary
*.pt    binary
*.onnx  binary
*.pth   binary
