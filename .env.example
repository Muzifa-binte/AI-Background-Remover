# ============================================================
# AI Background Remover — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----- AI Backend -----
# Options: "onnx" | "torch" | "rembg"
MODEL_BACKEND=rembg

# Path to ONNX model weights (only used when MODEL_BACKEND=onnx)
ONNX_MODEL_PATH=ai/models/model.onnx

# Path to PyTorch model weights (only used when MODEL_BACKEND=torch)
TORCH_MODEL_PATH=ai/models/model.pth

# ----- MongoDB -----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_bg_remover

# ----- Server -----
PORT=8000
